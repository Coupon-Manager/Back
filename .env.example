# PostgreSQL
POSTGRES_USER=coupon
POSTGRES_PASSWORD=coupon
POSTGRES_DB=coupon
DATABASE_URL=postgresql://coupon:coupon@db:5432/coupon

# API
SECRET_KEY=                        # generate with: openssl rand -hex 32
ALLOWED_EMAILS=                    # comma-separated, e.g. you@gmail.com,friend@gmail.com
CORS_ORIGINS=http://localhost:5173 # comma-separated, add your frontend domain
SYSTEM_USER_ID=1

# Gmail IMAP (for email import)
GMAIL_USER=                        # gmail address to read coupons from
GMAIL_APP_PASSWORD=                # Gmail app password (not your login password)

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=           # from dash.cloudflare.com > Zero Trust > Tunnels

# Cloudflare R2 (for DB backups)
R2_ACCOUNT_ID=                     # from R2 overview page
R2_ACCESS_KEY_ID=                  # from R2 API token
R2_SECRET_ACCESS_KEY=              # from R2 API token
R2_BUCKET_NAME=coupon-assets
